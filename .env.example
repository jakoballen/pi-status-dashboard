# =========================
# Pi Status Dashboard Config
# =========================

# -------------------------
# Pi-hole (required for stats)
# -------------------------
PIHOLE_PASSWORD=your_pihole_password_here

# -------------------------
# Terminal Access (optional)
# -------------------------
# Local example:
# TERMINAL_URL=http://192.168.1.100:7681

# Cloudflare Tunnel example:
# TERMINAL_URL=https://your-subdomain.trycloudflare.com

TERMINAL_URL=

# -------------------------
# Notes
# -------------------------
# - PIHOLE_PASSWORD is required for Pi-hole v6 API authentication
# - TERMINAL_URL enables the "Terminal" button in the dashboard
# - Leave TERMINAL_URL empty if you don't want the button